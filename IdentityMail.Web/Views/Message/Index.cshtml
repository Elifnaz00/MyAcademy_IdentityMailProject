@model PagedList.Core.IPagedList<UserMessage>

@{
    ViewData["Title"] = "Gelen Kutusu";
    Layout = "_UserLayout";
}

<main class="main-content">

    <!-- Header / Filters -->
    <div class="page-header">

        <div>
            <h2 class="page-title">
                Gelen Kutusu
            </h2>
        </div>

        <!-- Search -->
        <form asp-controller="Message" asp-action="Index" method="get" class="search-container d-none d-md-block">

            <input class="search-input"
                   placeholder="Gelen kutusunda ara..."
                   name="search"
                   type="text" />

        </form>

        <!-- Filter Button -->
        <button type="button"
                class="filter-btn"
                id="filterToggle">

            <span class="material-symbols-outlined" style="font-size: 18px;">
                filter_list
            </span>

            Filtrele
        </button>

    </div>


    <!-- Filter Panel -->
    <div class="filter-panel" id="filterPanel">

        <form asp-controller="Message"
              asp-action="Index"
              method="get"
              class="filter-form">

            <!-- Read Status -->
            <div class="filter-group">

                <label>Okunma Durumu</label>

                <select name="isRead" class="filter-input">
                    <option value="">Tüm Mesajlar</option>
                    <option value="true">Okunan</option>
                    <option value="false">Okunmayan</option>
                </select>

            </div>


            <!-- Importance -->
            <div class="filter-group">

                <label>Önem</label>

                <select name="isImportant" class="filter-input">
                    <option value="">Tümü</option>
                    <option value="true">Önemli</option>
                    <option value="false">Normal</option>
                </select>

            </div>


            <!-- Sort -->
            <div class="filter-group">

                <label>Sıralama</label>

                <select name="sortOrder" class="filter-input">
                    <option value="new">Yeni → Eski</option>
                    <option value="old">Eski → Yeni</option>
                </select>

            </div>


            <!-- Apply -->
            <button type="submit" class="filter-apply-btn">
                Filtrele
            </button>

        </form>

    </div>


    <!-- Email List -->
    <div class="email-list custom-scrollbar">

        @foreach (var item in Model)
        {
            <div class="email-item email-unread">

                <div id="mailid" data-id="@item.Id"></div>
                <div class="unread-indicator-bar"></div>

                <!-- Email Header -->
                <div class="email-header">

                    <!-- Sender -->
                    <div class="email-sender">

                        <div class="profile-image-wrapper">
                            <img src=@item.Sender.ProfileImageUrl
                             alt="Profil"
                             class="email-profile-image" />
                    </div>

                        <div class="unread-dot"></div>

                        <span class="sender-name">
                            @item.Sender.FirstName @item.Sender.LastName
                        </span>

                    </div>


                    <!-- Right Side -->
                    <div class="email-actions">

                        <span class="email-time">
                            @item.SendDate.ToString("dd.MM.yyyy HH:mm")
                        </span>

                        <form method="post"
                              asp-controller="Message"
                              asp-action="MessageCategoryAssign">

                            <input type="hidden"
                                   name="messageId"
                                   value="@item.Id" />

                            @Html.DropDownList(
                                                "categoryId",
                                                new SelectList(
                                                ViewBag.Categories as IEnumerable<SelectListItem>,
                                                "Value",
                                                "Text",
                                                item.CategoryId
                                                ),
                                                new { @class = "categories-dropdown" }
                                                )

                        <button class="category-change-btn" type="submit">
                            Kategori Değiştir
                        </button>

                    </form>


                    <a href="/Message/ToggleImportant/@item.Id"
                       class="nav-btn important-btn @(item.IsImportant ? "important-active" : "")">

                        <span class="material-symbols-outlined">
                            @(item.IsImportant ? "star" : "star_border")
                        </span>

                    </a>

                    <a href="/Message/MoveToTrash/@item.Id"
                       class="nav-btn delete-btn">

                        <span class="material-symbols-outlined">
                            delete
                        </span>

                    </a>

                </div>

            </div>


            <!-- Email Body -->
            <div class="email-body" data-id="@item.Id">

                <div class="mail-info-row">

                    <span class="mail-label">Konu :</span>

                    <h3 class="email-subject">
                        @item.Subject
                    </h3>

                </div>

                <div class="mail-message">

                    <p class="email-preview">
                        @(item.Body.Length > 80
                                                ? item.Body.Substring(0, 80)
                                                : item.Body)
                    </p>

                    </div>

                </div>

            </div>
                }

    </div>


    <!-- Pagination -->
    <div class="d-flex justify-content-center mt-4 pagination-container">

        <pager list="@Model"
               asp-controller="Message"
               asp-action="Index" />

    </div>

</main>


<style>

    /* Tarih */
    .email-time {
        display: block;
        min-width: 125px;
        text-align: right;
        white-space: nowrap;
        font-size: 12px;
        opacity: 0.75;
    }


    /* Konu */
    .mail-info-row {
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin-bottom: 10px;
    }

    .mail-label {
        font-size: 12px;
        font-weight: 600;
        color: #8f8f8f;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        flex-shrink: 0;
    }

    .email-subject {
        font-size: 14px;
        font-weight: 600;
        margin: 0;
        line-height: 1.4;
    }


    /* Mesaj */
    .mail-message {
        padding-left: 0;
    }

    .email-preview {
        font-size: 16px;
        line-height: 1.5;
        margin: 0;
        color: #a8a8a8;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 100%;
    }


    /* Mail üst sağ taraf */
    .email-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }


    /* Mail Card */
    .email-item {
        background-color: #292929;
        border-radius: 10px;
        margin-bottom: 10px;
        border: 1px solid #3a3a3a;
        padding: 16px 18px;
        transition: border-color 0.2s ease, background-color 0.2s ease;
    }

        .email-item:hover {
            background-color: #2d2d2d;
            border-color: #4a4a4a;
        }


    /* Mail Header */
    .email-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 14px;
    }


    /* Sender */
    .email-sender {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .sender-name {
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
    }


    /* Profil Fotoğrafı */
    .profile-image-wrapper {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
    }

    .email-profile-image {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
        display: block;
        border: 1px solid #4a4a4a;
    }


    /* Kategori */
    .category-form {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .categories-dropdown,
    .category-change-btn {
        height: 36px;
        border: 1px solid #3a3a3a;
        border-radius: 8px;
        background-color: #292929;
        color: #f1f1f1;
        font-size: 13px;
        font-weight: 500;
    }

    .categories-dropdown {
        min-width: 130px;
        padding: 0 10px;
        outline: none;
    }

    .category-change-btn {
        padding: 0 12px;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

        .category-change-btn:hover {
            background-color: #363636;
            border-color: #4a4a4a;
            color: #ffffff;
        }

    .categories-dropdown option {
        background-color: #292929;
        color: #f1f1f1;
    }


    /* Sil Butonu */
    .delete-btn {
        flex-shrink: 0;
        transition: all 0.2s ease;
    }

        .delete-btn:hover {
            color: var(--error) !important;
            background-color: rgba(255, 180, 171, 0.1) !important;
        }


    /* Filtre Header */
    .page-header {
        display: flex;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
    }


    /* Search */
    .search-container {
        position: relative;
        flex: 1;
        max-width: 400px;
    }


    /* Filtre Paneli */
    .filter-panel {
        display: none;
        margin-top: 16px;
        padding: 20px;
        background: var(--surface-container-low);
        border-radius: 12px;
    }

        .filter-panel.active {
            display: block;
        }


    /* Filtreler */
    .filter-form {
        display: flex;
        align-items: end;
        gap: 16px;
        flex-wrap: wrap;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .filter-group label {
            font-size: 13px;
            font-weight: 500;
        }

    .filter-input {
        min-width: 150px;
        height: 40px;
        padding: 0 10px;
        border-radius: 8px;
        border: 1px solid var(--outline);
        background: var(--surface);
    }

    .filter-apply-btn {
        height: 40px;
        padding: 0 18px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
    }


    /* Liste */
    .email-list {
        min-height: 450px;
        margin-top: 20px;
    }


    /* Pagination */
    .pagination-container {
        margin-top: 24px !important;
        padding-top: 10px;
        padding-bottom: 20px;
    }

        .pagination-container ul.pagination {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            margin: 0;
        }

        .pagination-container .page-item {
            margin: 0;
        }

        .pagination-container .page-link {
            min-width: 36px;
            height: 36px;
            padding: 0 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #3a3a3a;
            border-radius: 8px !important;
            background-color: #292929;
            color: #bdbdbd;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.2s ease;
        }

            .pagination-container .page-link:hover {
                background-color: #363636;
                border-color: #555;
                color: #ffffff;
            }

        .pagination-container .page-item.active .page-link {
            background-color: #3f3f3f;
            border-color: #666;
            color: #ffffff;
            font-weight: 600;
        }

        .pagination-container .page-item.disabled .page-link {
            background-color: #242424;
            border-color: #333;
            color: #666;
        }


    /* Önemli */
    .important-btn {
        flex-shrink: 0;
        transition: all 0.2s ease;
    }

        .important-btn:hover {
            color: #f5b301 !important;
            background-color: rgba(245, 179, 1, 0.1) !important;
        }

    .important-active {
        color: #f5b301 !important;
    }


    /* Mobil */
    @@media (max-width: 768px) {

        .email-actions {
            gap: 4px;
        }

        .email-time {
            min-width: auto;
            font-size: 11px;
        }

        .page-header {
            align-items: stretch;
        }

        .search-container {
            max-width: none;
            width: 100%;
        }

        .filter-form {
            flex-direction: column;
            align-items: stretch;
        }

        .filter-input {
            width: 100%;
        }

        .filter-apply-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <script>

        document.getElementById("filterToggle").addEventListener("click", function () {

            document.getElementById("filterPanel")
                .classList.toggle("active");

        });
    </script>
}