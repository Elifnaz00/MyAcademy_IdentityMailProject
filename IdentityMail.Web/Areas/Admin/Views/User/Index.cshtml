@using IdentityMail.Web.Areas.Admin.Models
@using PagedList.Core
@model PagedList<UserRoleListViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main class="main-content">
    <header class="hidden md:flex justify-between items-center px-margin-lg h-16 shrink-0 border-b border-outline-dark bg-background z-30">
        <div class="flex items-center gap-4">
            <h1 class="font-headline-md text-headline-md font-bold text-on-surface">Kullanıcı Yönetimi</h1>
        </div>
     
    </header>
    
    <div class="flex-1 overflow-y-auto p-gutter md:p-margin-lg">
    
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
           
            <div class="flex items-center gap-3 w-full md:w-auto">
               
            </div>
        
            <div class="flex items-center gap-3 w-full md:w-auto">
                
                <a href="/Admin/User/RoleAssign" class="flex items-center justify-center h-10 px-4 bg-primary-container text-surface-dim font-label-md text-label-md rounded-md hover:bg-primary-fixed-dim transition-colors">
                    <span class="material-symbols-outlined text-[18px] mr-2">person_add</span>
                    Kullanıcıya Rol Ata
                </a>
            </div>
        </div>
      
        <div class="glass-panel rounded-xl overflow-hidden flex flex-col shadow-lg shadow-black/20">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse user-table">
                    <thead>
                        <tr class="border-b border-outline-dark bg-surface-container-lowest/50 text-on-surface-variant font-label-md text-label-md uppercase tracking-wider">
                            
                            <th class="py-4 px-6 font-semibold">Kullanıcı Adı/Mail</th>
                            <th></th>
                            <th class="py-4 px-6 font-semibold">İsim Soyisim</th>
                          
                            <th class="py-4 px-6 font-semibold">Rol</th>
                            <th class="py-4 px-6 font-semibold">Durum</th>
                            <th class="py-4 px-6 font-semibold text-right">Aktif/Pasif Yap</th>
                        </tr>
                    </thead>
                    <tbody class="font-body-md text-body-md text-on-surface">
                       
                       
                       @foreach(var item in Model)
                        {
                            <tr class="border-b border-outline-dark/50 hover:bg-surface-container-low/50 transition-colors group relative opacity-70 hover:opacity-100">
                             
                             
                               
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-4">
                                        <div class="h-10 w-10 rounded-full overflow-hidden border border-outline-dark shrink-0 grayscale group-hover:grayscale-0 transition-all">
                                            <img alt="Michael Chen" class="w-full h-full object-cover" data-alt="image" src="@item.Image" />
                                        </div>
                                        <div>
                                            <div class="font-headline-sm text-headline-sm text-on-surface mb-0.5">@item.UserName</div>
                                            <div class="font-caption text-caption text-on-surface-muted">@item.Email</div>
                                        </div>
                                     
                                    </div>
                                </td>
                                <td>
                                    <input id="user-id" type="hidden" value="@item.UserId" data- />
                                </td>
                                <td class="py-4 px-6">
                                    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-surface-container-highest/50 border border-outline-dark text-on-surface-variant">
                                        
                                        <span class="font-caption text-caption">@item.FullName</span>
                                    </div>
                                </td>
                                <td class="py-4 px-6">
                                    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-surface-container-highest/50 border border-outline-dark text-on-surface-variant">
                                        <span class="material-symbols-outlined text-[14px]">edit_document</span>
                                        <span class="font-caption text-caption"> @(@item.Roles.FirstOrDefault() ?? "Rol Yok") </span>
                                    </div>
                                </td>
                                <td class="py-4 px-6">
                                    <div class="inline-flex items-center gap-2">
                                        <span class="h-2 w-2 rounded-full bg-outline-dark"></span>
                                        <span class="font-caption text-caption text-on-surface-muted">@item.IsActive</span>
                                    </div>
                                </td>
                                <td class="py-4 px-6 text-right">
                                    <div class="flex justify-end items-center gap-2">
                                       
                                            <button class="text-on-surface-muted hover:text-primary transition-colors p-1.5 rounded-md hover:bg-surface-container-highest active-or-passive" title="Activate">
                                                <span class="material-symbols-outlined text-[18px]">check_circle</span>
                                            </button>
                                      
                                    </div>
                                </td>
                            </tr>

                        }
                       
                    </tbody>
                </table>
            </div>
           
           
        </div>
      
    </div>
    <div class="flex justify-center mt-6">
        <pager list="@Model"
               asp-controller="User"
               asp-action="Index"
               asp-area="Admin" />
    </div>
    
</main>

