
@model LoginDto

@{
    ViewData["Title"] = "Login";
    Layout = "_UserLoginLayout";
}

<!DOCTYPE html>

<html class="light" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />

    <title>Giriş - SecureMail</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700;800&family=JetBrains+Mono:wght@500&display=swap"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
          rel="stylesheet" />

    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",

            theme: {
                extend: {

                    colors: {
                        "surface": "#131313",
                        "on-tertiary-fixed": "#00201c",
                        "on-primary": "#5a1c00",
                        "background": "#131313",
                        "outline": "#ab8a7d",
                        "secondary-fixed-dim": "#c8c6c5",
                        "on-surface": "#e5e2e1",
                        "surface-container-highest": "#353534",
                        "surface-dim": "#131313",
                        "on-error-container": "#ffdad6",
                        "on-tertiary-fixed-variant": "#005047",
                        "tertiary-container": "#00a695",
                        "inverse-surface": "#e5e2e1",
                        "inverse-primary": "#a63b00",
                        "primary-container": "#ff5f00",
                        "on-error": "#690005",
                        "surface-container-lowest": "#0e0e0e",
                        "tertiary-fixed": "#62fae3",
                        "surface-container-high": "#2a2a2a",
                        "on-tertiary-container": "#00332d",
                        "primary": "#ffb599",
                        "primary-fixed-dim": "#ffb599",
                        "on-secondary-fixed": "#1c1b1b",
                        "on-secondary": "#313030",
                        "on-secondary-container": "#b7b5b4",
                        "on-primary-fixed": "#370e00",
                        "on-background": "#e5e2e1",
                        "on-primary-fixed-variant": "#7f2b00",
                        "surface-container-low": "#1c1b1b",
                        "on-secondary-fixed-variant": "#474746",
                        "surface-tint": "#ffb599",
                        "primary-fixed": "#ffdbce",
                        "surface-variant": "#353534",
                        "secondary-container": "#474746",
                        "tertiary-fixed-dim": "#3cddc7",
                        "secondary-fixed": "#e5e2e1",
                        "surface-container": "#201f1f",
                        "surface-bright": "#3a3939",
                        "secondary": "#c8c6c5",
                        "on-surface-variant": "#e4bfb1",
                        "on-tertiary": "#003731",
                        "tertiary": "#3cddc7",
                        "inverse-on-surface": "#313030",
                        "error-container": "#93000a",
                        "outline-variant": "#5b4137",
                        "on-primary-container": "#531a00",
                        "error": "#ffb4ab"
                    },

                    borderRadius: {
                        "DEFAULT": "0.375rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },

                    spacing: {
                        "gutter": "24px",
                        "margin-desktop": "32px",
                        "container-max": "1440px",
                        "margin-mobile": "16px",
                        "unit": "4px",
                        "sm": "12px",
                        "base": "8px",
                        "md": "20px",
                        "lg": "32px",
                        "xs": "4px",
                        "xl": "48px"
                    },

                    fontFamily: {
                        "body-md": ["Hanken Grotesk"],
                        "headline-lg-mobile": ["Hanken Grotesk"],
                        "headline-lg": ["Hanken Grotesk"],
                        "label-sm": ["JetBrains Mono"],
                        "display-lg": ["Hanken Grotesk"],
                        "body-sm": ["Hanken Grotesk"]
                    },

                    fontSize: {

                        "body-md": [
                            "15px",
                            {
                                lineHeight: "1.5",
                                fontWeight: "400"
                            }
                        ],

                        "headline-lg-mobile": [
                            "22px",
                            {
                                lineHeight: "1.2",
                                fontWeight: "700"
                            }
                        ],

                        "headline-lg": [
                            "30px",
                            {
                                lineHeight: "1.2",
                                letterSpacing: "-0.01em",
                                fontWeight: "700"
                            }
                        ],

                        "label-sm": [
                            "12px",
                            {
                                lineHeight: "1",
                                letterSpacing: "0.05em",
                                fontWeight: "500"
                            }
                        ],

                        "display-lg": [
                            "44px",
                            {
                                lineHeight: "1.1",
                                letterSpacing: "-0.02em",
                                fontWeight: "800"
                            }
                        ],

                        "body-sm": [
                            "13px",
                            {
                                lineHeight: "20px",
                                fontWeight: "400"
                            }
                        ]
                    }
                }
            }
        }
    </script>

    <style>

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .input-glow:focus {
            box-shadow: 0 0 0 3px rgba(255, 95, 0, 0.2);
        }

        .bg-pattern {
            background-color: #131313;
            background-image: radial-gradient( circle at 100% 0%, #2a2a2a 0%, transparent 50% ), radial-gradient( circle at 0% 100%, #1c1b1b 0%, transparent 50% );
            background-size: 100% 100%;
        }

        /* Login kartı */

        .login-card {
            width: 100%;
            max-width: 500px;
        }

        /* Footer */

        .login-footer {
            width: calc(100% - 32px);
            max-width: 900px;
        }

        @@media (max-width: 768px) {

            .login-card {
                max-width: 100%;
            }

            .login-footer {
                width: calc(100% - 24px);
            }
        }

    </style>

</head>


<body class="bg-pattern text-on-background min-h-screen flex justify-center items-center p-4 antialiased">

    <!-- LOGIN CARD -->

    <main class="login-card bg-surface-container-lowest rounded-xl border border-outline-variant shadow-lg overflow-hidden flex flex-col relative z-10">


        <!-- HEADER -->

        <div class="px-lg pt-lg pb-md text-center border-b border-surface-container-high bg-surface-container-lowest">

            <h1 class="font-headline-lg text-headline-lg text-primary-container flex items-center justify-center gap-sm">

                <span aria-hidden="true"
                      class="material-symbols-outlined text-[30px]">
                    lock
                </span>

                CorMail

            </h1>


            <p class="font-body-md text-body-md text-secondary mt-xs">
                Kurumsal İletişim Ağına Giriş Yapın
            </p>

        </div>


        <!-- FORM -->

        <div class="px-lg py-lg bg-surface-container-lowest">

            <form asp-action="Login"
                  asp-controller="Auth"
                  method="post"
                  class="flex flex-col gap-md">


                <!-- EMAIL -->

                <div class="flex flex-col gap-xs">

                    <label class="font-body-sm text-body-sm text-on-surface"
                           for="email">
                        E-posta Adresi
                    </label>


                    <div class="relative">

                        <span class="absolute inset-y-0 left-0 flex items-center pl-md text-outline">

                            <span aria-hidden="true"
                                  class="material-symbols-outlined text-[20px]">
                                mail
                            </span>

                        </span>


                        <input asp-for="Email"
                               class="w-full pl-[56px] pr-md py-sm bg-surface border border-outline-variant rounded-DEFAULT font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none focus:border-primary-container input-glow transition-all"
                               id="email"
                               name="email"
                               placeholder="ad.soyad@sirket.com"
                               required
                               type="email" />

                    </div>

                </div>


                <!-- PASSWORD -->

                <div class="flex flex-col gap-xs">

                    <label class="font-body-sm text-body-sm text-on-surface"
                           for="password">
                        Şifre
                    </label>


                    <div class="relative">

                        <span class="absolute inset-y-0 left-0 flex items-center pl-md text-outline">

                            <span aria-hidden="true"
                                  class="material-symbols-outlined text-[20px]">
                                key
                            </span>

                        </span>


                        <input asp-for="Password"
                               class="w-full pl-[56px] pr-[56px] py-sm bg-surface border border-outline-variant rounded-DEFAULT font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none focus:border-primary-container input-glow transition-all"
                               id="password"
                               name="password"
                               placeholder="••••••••"
                               required
                               type="password" />


                        <button aria-label="Şifreyi Göster"
                                class="absolute inset-y-0 right-0 flex items-center pr-md text-outline hover:text-primary-container transition-colors"
                                type="button">

                            <span aria-hidden="true"
                                  class="material-symbols-outlined text-[20px]">
                                visibility
                            </span>

                        </button>

                    </div>

                </div>


                <!-- REMEMBER / FORGOT -->

                <div class="flex items-center justify-between">

                    <label class="flex items-center gap-sm cursor-pointer group">

                        <input class="w-4 h-4 rounded-sm border-outline-variant text-primary-container focus:ring-primary-container bg-surface cursor-pointer group-hover:border-primary-container transition-colors"
                               type="checkbox" />

                        <span class="font-body-sm text-body-sm text-secondary group-hover:text-on-surface transition-colors">
                            Beni Hatırla
                        </span>

                    </label>


                    <a class="font-body-sm text-body-sm text-primary-container hover:underline hover:text-primary transition-colors font-semibold"
                       href="#">
                        Şifremi Unuttum
                    </a>

                </div>


                <!-- VALIDATION -->

                <div class="text-danger text-sm">

                    @Html.ValidationSummary()

                </div>


                <!-- LOGIN BUTTON -->

                <button class="w-full bg-primary-container text-on-primary font-body-md text-body-md font-semibold py-sm px-lg rounded-DEFAULT hover:bg-inverse-primary transition-colors shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-container focus:ring-offset-surface-container-lowest flex items-center justify-center gap-sm"
                        type="submit">

                    Giriş Yap

                    <span aria-hidden="true"
                          class="material-symbols-outlined text-[20px]">
                        arrow_forward
                    </span>

                </button>

            </form>

        </div>


        <!-- REGISTER -->

        <div class="px-lg py-md bg-surface-container-low border-t border-surface-container-high text-center">

            <p class="font-body-sm text-body-sm text-secondary">

                Hesabınız yok mu?

                <a class="font-body-sm text-body-sm text-primary-container hover:underline ml-xs font-semibold"
                   href="/Auth/Register">
                    Kayıt Ol
                </a>

            </p>

        </div>

    </main>


    <!-- FOOTER -->

    <footer class="login-footer absolute bottom-4 left-1/2 -translate-x-1/2 flex flex-col md:flex-row justify-center items-center px-md py-sm gap-sm border-t border-outline-variant bg-surface-container-lowest rounded-lg opacity-90">

        <div class="font-body-sm text-body-sm text-primary-container font-semibold">
            SecureMail
        </div>


        <div class="font-body-sm text-body-sm text-secondary">
            © 2024 SecureMail Inc. All rights reserved.
        </div>


        <nav class="flex gap-md font-body-sm text-body-sm">

            <a class="text-on-surface-variant hover:text-primary-container hover:underline transition-all"
               href="#">
                Privacy Policy
            </a>

            <a class="text-on-surface-variant hover:text-primary-container hover:underline transition-all"
               href="#">
                Terms of Service
            </a>

            <a class="text-on-surface-variant hover:text-primary-container hover:underline transition-all"
               href="#">
                Help Center
            </a>

            <a class="text-on-surface-variant hover:text-primary-container hover:underline transition-all"
               href="#">
                Contact Security
            </a>

        </nav>

    </footer>

</body>
</html>

