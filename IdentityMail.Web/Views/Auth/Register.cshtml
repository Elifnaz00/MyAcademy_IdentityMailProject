@using IdentityMail.Web.DTOs.UserDtos
@model RegisterDto

@{
    ViewData["Title"] = "Register";
    Layout = "_UserLoginLayout";
}

<!DOCTYPE html>

<html class="dark" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>SecureMail - Kayıt Ol</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
          tailwind.config = {
            darkMode: "class",
            theme: {
              extend: {
                "colors": {
                        "surface": "#131313",
                        "on-tertiary-fixed": "#00201c",
                        "on-primary": "#5a1c00",
                        "background": "#131313",
                        "outline": "#ab8a7d",
                        "secondary-fixed-dim": "#c8c6c5",
                        "on-surface": "#e5e2e1",
                        "surface-container-highest": "#353534",
                        "surface-dim": "#131313",
                        "on-error-container": "#ffdad6",
                        "on-tertiary-fixed-variant": "#005047",
                        "tertiary-container": "#00a695",
                        "inverse-surface": "#e5e2e1",
                        "inverse-primary": "#a63b00",
                        "primary-container": "#ff5f00",
                        "on-error": "#690005",
                        "surface-container-lowest": "#0e0e0e",
                        "tertiary-fixed": "#62fae3",
                        "surface-container-high": "#2a2a2a",
                        "on-tertiary-container": "#00332d",
                        "primary": "#ffb599",
                        "primary-fixed-dim": "#ffb599",
                        "on-secondary-fixed": "#1c1b1b",
                        "on-secondary": "#313030",
                        "on-secondary-container": "#b7b5b4",
                        "on-primary-fixed": "#370e00",
                        "on-background": "#e5e2e1",
                        "on-primary-fixed-variant": "#7f2b00",
                        "surface-container-low": "#1c1b1b",
                        "on-secondary-fixed-variant": "#474746",
                        "surface-tint": "#ffb599",
                        "primary-fixed": "#ffdbce",
                        "surface-variant": "#353534",
                        "secondary-container": "#474746",
                        "tertiary-fixed-dim": "#3cddc7",
                        "secondary-fixed": "#e5e2e1",
                        "surface-container": "#201f1f",
                        "surface-bright": "#3a3939",
                        "secondary": "#c8c6c5",
                        "on-surface-variant": "#e4bfb1",
                        "on-tertiary": "#003731",
                        "tertiary": "#3cddc7",
                        "inverse-on-surface": "#313030",
                        "error-container": "#93000a",
                        "outline-variant": "#5b4137",
                        "on-primary-container": "#531a00",
                        "error": "#ffb4ab"
                },
                "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                },
                "spacing": {
                        "gutter": "24px",
                        "margin-desktop": "64px",
                        "container-max": "1440px",
                        "margin-mobile": "16px",
                        "unit": "4px"
                },
                "fontFamily": {
                        "body-md": [
                                "Hanken Grotesk"
                        ],
                        "headline-lg-mobile": [
                                "Hanken Grotesk"
                        ],
                        "headline-lg": [
                                "Hanken Grotesk"
                        ],
                        "label-sm": [
                                "JetBrains Mono"
                        ],
                        "display-lg": [
                                "Hanken Grotesk"
                        ]
                },
                "fontSize": {
                        "body-md": [
                                "16px",
                                {
                                        "lineHeight": "1.6",
                                        "fontWeight": "400"
                                }
                        ],
                        "headline-lg-mobile": [
                                "24px",
                                {
                                        "lineHeight": "1.2",
                                        "fontWeight": "700"
                                }
                        ],
                        "headline-lg": [
                                "32px",
                                {
                                        "lineHeight": "1.2",
                                        "letterSpacing": "-0.01em",
                                        "fontWeight": "700"
                                }
                        ],
                        "label-sm": [
                                "12px",
                                {
                                        "lineHeight": "1.0",
                                        "letterSpacing": "0.05em",
                                        "fontWeight": "500"
                                }
                        ],
                        "display-lg": [
                                "48px",
                                {
                                        "lineHeight": "1.1",
                                        "letterSpacing": "-0.02em",
                                        "fontWeight": "800"
                                }
                        ]
                }
        },
            },
          }
    </script>
</head>
<body class="min-h-screen flex items-center justify-center p-gutter md:p-margin-desktop bg-background text-on-surface relative overflow-hidden">
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
        <div class="absolute top-[-10%] left-[-10%] w-[500px] h-[500px] bg-primary-container/20 rounded-full blur-[120px]"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[500px] h-[500px] bg-tertiary-container/10 rounded-full blur-[120px]"></div>
    </div>
    <main class="w-full max-w-md bg-surface-container-highest/80 backdrop-blur-md border border-outline-variant/30 rounded-xl shadow-2xl p-6 md:p-12 overflow-hidden relative z-10">
        <div class="text-center mb-12">
            <h1 class="font-headline-lg text-headline-lg text-primary mb-3 flex items-center justify-center gap-3">
                <span class="material-symbols-outlined" data-icon="lock" data-weight="fill" style="font-size: 32px;">lock</span>
                SecureMail
            </h1>
            <p class="font-body-md text-body-md text-on-surface-variant">Kurumsal İletişim Ağına Katılın</p>
        </div>
        <form class="space-y-3" asp-action="Register" asp-controller="Auth" method="post">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div class="flex flex-col gap-1">
                    <label class="text-sm font-semibold text-on-surface" for="firstName">Ad</label>
                    <input class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-3 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/30 transition-shadow" asp-for="FirstName" id="firstName" name="firstName" required="" type="text" />
                </div>
                <div class="flex flex-col gap-1">
                    <label class="text-sm font-semibold text-on-surface" for="lastName">Soyad</label>
                    <input class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-3 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/30 transition-shadow" asp-for="LastName" id="lastName" name="lastName" required="" type="text" />
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <label class="text-sm font-semibold text-on-surface" for="username">Kullanıcı Adı</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-outline">
                        <span class="material-symbols-outlined" data-icon="person" style="font-size: 20px;">person</span>
                    </span>
                    <input asp-for="UserName" class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg pl-12 pr-3 py-3 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/30 transition-shadow" id="username" name="username" required="" type="text" />
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <label class="text-sm font-semibold text-on-surface" for="email">E-posta</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-outline">
                        <span class="material-symbols-outlined" data-icon="mail" style="font-size: 20px;">mail</span>
                    </span>
                    <input asp-for="Email" class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg pl-12 pr-3 py-3 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/30 transition-shadow" id="email" name="email" required="" type="email" />
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <label class="text-sm font-semibold text-on-surface" for="password">Şifre</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-outline">
                        <span class="material-symbols-outlined" data-icon="key" style="font-size: 20px;">key</span>
                    </span>
                    <input asp-for="Password" class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg pl-12 pr-3 py-3 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/30 transition-shadow" id="password" name="password" required="" type="password" />
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <label class="text-sm font-semibold text-on-surface" for="confirmPassword">Şifre Tekrar</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-outline">
                        <span class="material-symbols-outlined" data-icon="key" style="font-size: 20px;">key</span>
                    </span>
                    <input asp-for="ConfirmPassword" class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg pl-12 pr-3 py-3 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/30 transition-shadow" id="confirmPassword" name="confirmPassword" required="" type="password" />
                </div>
            </div>
            <br />
            <span class="text-danger">@Html.ValidationSummary()</span>
            <br />
            <button class="w-full bg-primary-container text-on-primary-container font-label-sm text-label-sm uppercase py-3 px-3 rounded-lg hover:bg-primary hover:text-on-primary transition-colors duration-200 mt-6" type="submit">
                Kayıt Ol
            </button>
        </form>
        <div class="mt-6 text-center border-t border-outline-variant/30 pt-6">
            <p class="font-body-md text-body-md text-on-surface-variant">
                Zaten hesabınız var mı?
                <a class="text-primary hover:text-primary-container hover:underline text-sm font-semibold ml-1 transition-colors" href="#">Giriş Yap</a>
            </p>
        </div>
    </main>
</body>
</html>




