@model List<UserMessage>

@{
    ViewData["Title"] = "Trash";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<main class="main-content">

    <!-- Header / Filters -->
    <div class="page-header">

        <div>
            <h2 class="page-title">
                Çöp Kutusu
            </h2>
        </div>

        <div class="search-container d-none d-md-block">
            <span class="material-symbols-outlined search-icon">
                search
            </span>

            <input class="search-input"
                  
                   type="text" />
        </div>

        <div class="d-flex gap-2">

            <button class="filter-btn">
                <span class="material-symbols-outlined" style="font-size: 18px;">
                    filter_list
                </span>
                Filtrele
            </button>

            <button class="filter-btn">
                <span class="material-symbols-outlined" style="font-size: 18px;">
                    sort
                </span>
                Sırala
            </button>

        </div>

    </div>


    <!-- Email List -->
    <div class="email-list custom-scrollbar">

        @foreach (var item in Model)
        {
            <div class="email-item">

                <!-- Email Header -->
                <div class="email-header">

                    <!-- Sender -->
                    <div class="email-sender">

                        @if (!item.IsRead)
                        {
                            <div class="unread-dot"></div>
                        }

                    <span class="sender-name">
                        @(item.Sender != null
                                                ? $"{item.Sender.FirstName} {item.Sender.LastName}"
                                                : "Gönderen belirtilmemiş")
                                                                       </span>

                </div>


                <!-- Right Side -->
                <div class="email-actions">

                    <!-- Tarih -->
                    <span class="email-time">
                        @item.SendDate.ToString("dd.MM.yyyy HH:mm")
                    </span>


                    <!-- Çöpten Geri Al -->
                    <a href="/Message/Restore/@item.Id"
                       class="btn trash-restore-btn">

                        <span class="material-symbols-outlined">
                            restore_from_trash
                        </span>

                        Çöpten Geri Al

                    </a>


                    <!-- Tamamen Sil -->
                    <a href="/Message/Delete/@item.Id"
                       class="btn trash-delete-btn">

                        <span class="material-symbols-outlined">
                            delete_forever
                        </span>

                        Tamamen Sil

                    </a>

                </div>

            </div>


            <!-- Email Body -->
            <div class="email-body">

                <h3 class="email-subject">
                    @item.Subject
                </h3>

                <p class="email-preview">
                    @(item.Body != null && item.Body.Length > 80
                                        ? item.Body.Substring(0, 80) + "..."
                                        : item.Body)
                </p>

                </div>

            </div>
                }

    </div>

</main>

<style>

    /* Mail listesi */
    .email-list {
        min-height: 450px;
        margin-top: 20px;
    }


    /* Mail kartı */
    .email-item {
        background-color: #292929;
        border: 1px solid #3a3a3a;
        border-radius: 10px;
        margin-bottom: 10px;
        overflow: hidden;
        transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }


        .email-item:hover {
            background-color: #2d2d2d;
            border-color: #4a4a4a;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        }


        .email-item:last-child {
            margin-bottom: 0;
        }


    /* Mail header */
    .email-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 16px;
        border-bottom: 1px solid #3a3a3a;
    }


    /* Gönderen */
    .email-sender {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }


    .sender-name {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    /* Sağ taraf */
    .email-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }


    /* Tarih */
    .email-time {
        display: block;
        min-width: 125px;
        text-align: right;
        white-space: nowrap;
        font-size: 12px;
    }


    /* Mail içeriği */
    .email-body {
        padding: 14px 16px;
    }


    .email-subject {
        margin: 0 0 6px 0;
        font-size: 16px;
        font-weight: 600;
        color: #f1f1f1;
    }


    .email-preview {
        margin: 0;
        font-size: 14px;
        color: #b5b5b5;
        line-height: 1.5;
    }


    /* Okunmamış nokta */
    .unread-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background-color: var(--primary-container);
        flex-shrink: 0;
    }


    /* Çöpten geri al */
    .trash-restore-btn {
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 0 12px;
        border-radius: 8px;
        background-color: #3a3a3a;
        border: 1px solid #4a4a4a;
        color: #ffb599;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        transition: all 0.2s ease;
    }


        .trash-restore-btn:hover {
            background-color: #474747;
            border-color: #ffb599;
            color: #ffb599;
        }


        .trash-restore-btn .material-symbols-outlined {
            font-size: 18px;
        }


    /* Tamamen sil */
    .trash-delete-btn {
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 0 12px;
        border-radius: 8px;
        background-color: transparent;
        border: 1px solid #5a3a35;
        color: #ffb4ab;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        transition: all 0.2s ease;
    }


        .trash-delete-btn:hover {
            background-color: rgba(255, 180, 171, 0.1);
            border-color: #ffb4ab;
            color: #ffb4ab;
        }


        .trash-delete-btn .material-symbols-outlined {
            font-size: 18px;
        }


    /* Mobil */
    @@media (max-width: 768px) {

        .email-item {
            margin-bottom: 8px;
            border-radius: 8px;
        }


        .email-header {
            padding: 12px;
            gap: 8px;
        }


        .email-body {
            padding: 12px;
        }


        .email-actions {
            gap: 4px;
        }


        .email-time {
            min-width: auto;
            font-size: 11px;
        }


        .trash-restore-btn,
        .trash-delete-btn {
            height: 32px;
            padding-left: 8px;
            padding-right: 8px;
            font-size: 11px;
        }


            .trash-restore-btn .material-symbols-outlined,
            .trash-delete-btn .material-symbols-outlined {
                font-size: 16px;
            }
    }

</style>
