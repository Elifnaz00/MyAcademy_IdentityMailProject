@using IdentityMail.Web.DTOs.UserDtos
@model RegisterDto

@{
    ViewData["Title"] = "Register";
    Layout = "_UserLoginLayout";
}

<div class="relative w-full flex justify-center">

   
    <div class="fixed inset-0 z-0 overflow-hidden pointer-events-none">

        <div class="absolute top-[-10%] left-[-10%] w-[500px] h-[500px] bg-primary-container/20 rounded-full blur-[120px]"></div>

        <div class="absolute bottom-[-10%] right-[-10%] w-[500px] h-[500px] bg-tertiary-container/10 rounded-full blur-[120px]"></div>

    </div>

    <main class="w-full max-w-md bg-surface-container-highest/80 backdrop-blur-md border border-outline-variant/30 rounded-xl shadow-2xl p-6 md:p-8 overflow-hidden relative z-10">

        <div class="text-center mb-8">

            <h1 class="font-headline-lg text-headline-lg text-primary mb-3 flex items-center justify-center gap-3">

                <span class="material-symbols-outlined"
                      data-icon="lock"
                      data-weight="fill"
                      style="font-size: 32px;">
                    lock
                </span>

                SecureMail

            </h1>

            <p class="font-body-md text-body-md text-on-surface-variant">
                Kurumsal İletişim Ağına Katılın
            </p>

        </div>

        <form class="space-y-3"
              asp-action="Register"
              asp-controller="Auth"
              method="post">

            <!-- Ad Soyad -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">

                <div class="flex flex-col gap-1">

                    <label class="text-sm font-semibold text-on-surface"
                           for="firstName">
                        Ad
                    </label>

                    <input class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-3 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/30 transition-shadow"
                           asp-for="FirstName"
                           id="firstName"
                           name="firstName"
                           required
                           type="text" />

                </div>

                <div class="flex flex-col gap-1">

                    <label class="text-sm font-semibold text-on-surface"
                           for="lastName">
                        Soyad
                    </label>

                    <input class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-3 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/30 transition-shadow"
                           asp-for="LastName"
                           id="lastName"
                           name="lastName"
                           required
                           type="text" />

                </div>

            </div>

            <!-- Kullanıcı Adı -->
            <div class="flex flex-col gap-1">

                <label class="text-sm font-semibold text-on-surface"
                       for="username">
                    Kullanıcı Adı
                </label>

                <div class="relative">

                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-outline">

                        <span class="material-symbols-outlined"
                              data-icon="person"
                              style="font-size: 20px;">
                            person
                        </span>

                    </span>

                    <input asp-for="UserName"
                           class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg pl-12 pr-3 py-3 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/30 transition-shadow"
                           id="username"
                           name="username"
                           required
                           type="text" />

                </div>

            </div>

            <!-- E-posta -->
            <div class="flex flex-col gap-1">

                <label class="text-sm font-semibold text-on-surface"
                       for="email">
                    E-posta
                </label>

                <div class="relative">

                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-outline">

                        <span class="material-symbols-outlined"
                              data-icon="mail"
                              style="font-size: 20px;">
                            mail
                        </span>

                    </span>

                    <input asp-for="Email"
                           class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg pl-12 pr-3 py-3 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/30 transition-shadow"
                           id="email"
                           name="email"
                           required
                           type="email" />

                </div>

            </div>

            <!-- Şifre -->
            <div class="flex flex-col gap-1">

                <label class="text-sm font-semibold text-on-surface"
                       for="password">
                    Şifre
                </label>

                <div class="relative">

                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-outline">

                        <span class="material-symbols-outlined"
                              data-icon="key"
                              style="font-size: 20px;">
                            key
                        </span>

                    </span>

                    <input asp-for="Password"
                           class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg pl-12 pr-3 py-3 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/30 transition-shadow"
                           id="password"
                           name="password"
                           required
                           type="password" />

                </div>

            </div>

            <!-- Şifre Tekrar -->
            <div class="flex flex-col gap-1">

                <label class="text-sm font-semibold text-on-surface"
                       for="confirmPassword">
                    Şifre Tekrar
                </label>

                <div class="relative">

                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-outline">

                        <span class="material-symbols-outlined"
                              data-icon="key"
                              style="font-size: 20px;">
                            key
                        </span>

                    </span>

                    <input asp-for="ConfirmPassword"
                           class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg pl-12 pr-3 py-3 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/30 transition-shadow"
                           id="confirmPassword"
                           name="confirmPassword"
                           required
                           type="password" />

                </div>

            </div>

            <!-- Validation -->
            <div class="text-danger text-sm pt-1">
                @Html.ValidationSummary()
            </div>

            <!-- Kayıt Ol -->
            <button class="w-full bg-primary-container text-on-primary-container font-label-sm text-label-sm uppercase py-3 px-3 rounded-lg hover:bg-primary hover:text-on-primary transition-colors duration-200 mt-6"
                    type="submit">
                Kayıt Ol
            </button>

        </form>

        <!-- Giriş -->
        <div class="mt-6 text-center border-t border-outline-variant/30 pt-6">

            <p class="font-body-md text-body-md text-on-surface-variant">

                Zaten hesabınız var mı?

                <a class="text-primary hover:text-primary-container hover:underline text-sm font-semibold ml-1 transition-colors"
                   asp-controller="Auth"
                   asp-action="Login">
                    Giriş Yap
                </a>

            </p>

        </div>

    </main>
    

</div>
