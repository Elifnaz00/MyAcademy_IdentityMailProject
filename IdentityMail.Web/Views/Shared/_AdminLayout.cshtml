    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <style>
        body {
            background-color: #131313;
            color: #e5e2e1;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        .material-symbols-outlined {
            font-family: 'Material Symbols Outlined';
            font-weight: normal;
            font-style: normal;
            font-size: 24px;
            line-height: 1;
            letter-spacing: normal;
            text-transform: none;
            display: inline-block;
            white-space: nowrap;
            word-wrap: normal;
            direction: ltr;
            font-feature-settings: 'liga';
            -webkit-font-smoothing: antialiased;
        }

        /* Layout Grid */
        .dashboard-container {
            display: flex;
            min-height: 100vh;
        }

        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .content-area {
            padding: 24px;
            display: grid;
            gap: 24px;
        }

        /* Components */
        .card {
            background-color: #1c1b1b;
            border: 1px solid #333333;
            border-radius: 8px;
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 24px;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

            .data-table th, .data-table td {
                padding: 12px 16px;
                text-align: left;
                border-bottom: 1px solid #333333;
            }

            .data-table th {
                color: #a1a1aa;
                font-size: 12px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

            .data-table tr:hover {
                background-color: #2a2a2a;
            }

        .chart-placeholder {
            height: 200px;
            border-radius: 4px;
            background: linear-gradient(180deg, #2a2a2a 0%, #1c1b1b 100%);
            display: flex;
            align-items: flex-end;
            gap: 8px;
            padding: 16px;
            border: 1px dashed #474747;
        }

        .bar {
            flex: 1;
            background-color: #f97316;
            border-radius: 2px 2px 0 0;
            opacity: 0.8;
            transition: height 0.3s ease;
        }

            .bar:hover {
                opacity: 1;
                background-color: #ffb690;
            }

        .pill {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 600;
        }

        .pill-primary {
            background-color: rgba(249, 115, 22, 0.1);
            color: #f97316;
        }

        .pill-neutral {
            background-color: #2a2a2a;
            color: #e5e2e1;
        }

        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            object-fit: cover;
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <aside style="width: 260px; background-color: #201f1f; border-right: 1px solid #584237; display: flex; flex-direction: column; padding: 16px 0;">
            <div style="padding: 0 16px 24px 16px;">
                <div style="font-size: 18px; font-weight: 600; color: #e5e2e1;">Obsidian Mail</div>
                <div style="font-size: 12px; color: #a1a1aa;">Pro Account</div>
            </div>
            <nav style="display: flex; flex-direction: column;">
                <a href="/Admin/Dashboard/Index" style="display: flex; align-items: center; gap: 12px; padding: 12px 16px; color: #f97316; background-color: rgba(249, 115, 22, 0.1); border-left: 2px solid #f97316; text-decoration: none; font-size: 14px;">
                    <span class="material-symbols-outlined">dashboard</span>
                    Panel
                </a>
                <a href="/Admin/User/Index" style="display: flex; align-items: center; gap: 12px; padding: 12px 16px; color: #e0c0b1; text-decoration: none; font-size: 14px;">
                    <span class="material-symbols-outlined">inbox</span>
                    Kullanıcı İşlemleri
                </a>
                <a href="/Admin/User/Index" style="display: flex; align-items: center; gap: 12px; padding: 12px 16px; color: #e0c0b1; text-decoration: none; font-size: 14px;">
                    <span class="material-symbols-outlined">drafts</span>
                    Rol İşlemleri
                </a>
                <a href="/Admin/Complaint/Index" style="display: flex; align-items: center; gap: 12px; padding: 12px 16px; color: #e0c0b1; text-decoration: none; font-size: 14px;">
                    <span class="material-symbols-outlined">star</span>
                    Şikayetler
                </a>
              
              
            </nav>
        </aside>
        <!-- Main Content -->
@RenderBody()
        
    </div>
    <script>
              $('.active-or-passive').on('click', function() {
            var $row = $(this).closest('tr');
            var $id = $row.find('td #user-id').val();

           

            $.ajax({
                url: '/Admin/User/ToggleActive/',
                type: 'POST',
                data: {
                    userId: $id
                },
                datatype: 'json',
                success: function(){

                    location.reload();
                },
                error: function()
                {
                    alert("Bu numaraya ait kişi listede tanımlı değil!");
                }

            });
            

           
            
        });
    </script>

</body>


</html>