@using Microsoft.AspNetCore.Identity

@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager


<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />

    <title>@ViewData["Title"] - Obsidian Mail</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700&display=swap" rel="stylesheet" />

    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
   
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        :root {
            --outline-variant: #584237;
            --secondary-fixed-dim: #c8c6c6;
            --tertiary-fixed: #cde5ff;
            --on-surface-variant: #e0c0b1;
            --on-primary-fixed: #341100;
            --surface-tint: #ffb690;
            --on-error: #690005;
            --tertiary-container: #00a2f4;
            --surface: #131313;
            --surface-bright: #393939;
            --outline: #a78b7d;
            --surface-container-high: #2a2a2a;
            --error: #ffb4ab;
            --on-primary-container: #582200;
            --tertiary-fixed-dim: #93ccff;
            --primary-fixed: #ffdbca;
            --error-container: #93000a;
            --surface-variant: #353534;
            --secondary-fixed: #e4e2e1;
            --inverse-surface: #e5e2e1;
            --surface-container-highest: #353534;
            --on-tertiary-fixed-variant: #004b74;
            --surface-container: #201f1f;
            --on-tertiary-container: #003554;
            --secondary-container: #474747;
            --inverse-on-surface: #313030;
            --on-primary: #552100;
            --outline-dark: #333333;
            --on-surface-muted: #a1a1aa;
            --on-surface: #e5e2e1;
            --primary: #ffb690;
            --inverse-primary: #9d4300;
            --on-error-container: #ffdad6;
            --surface-container-low: #1c1b1b;
            --on-background: #e5e2e1;
            --on-secondary-fixed: #1b1c1c;
            --primary-container: #f97316;
            --secondary: #c8c6c6;
            --on-secondary-container: #b6b5b4;
            --background: #131313;
            --on-secondary-fixed-variant: #474747;
            --surface-dim: #131313;
            --on-tertiary: #003351;
            --on-primary-fixed-variant: #783200;
            --on-secondary: #303030;
            --surface-container-lowest: #0e0e0e;
            --on-tertiary-fixed: #001d32;
            --tertiary: #93ccff;
            --primary-fixed-dim: #ffb690;
            --sidebar-width: 260px;
            --margin-lg: 24px;
            --gutter: 16px;
            --unit: 4px;
            --font-inter: 'Inter', sans-serif;
        }


        /* GENEL */

        * {
            box-sizing: border-box;
        }

        body {
            background-color: var(--background);
            color: var(--on-surface);
            font-family: var(--font-inter);
            font-size: 14px;
            line-height: 1.5;
            margin: 0;
            padding: 0;
            height: 100vh;
            overflow: hidden;
        }

        a {
            text-decoration: none;
        }

        ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }


        /* SIDEBAR */

        .sidebar {
            width: var(--sidebar-width);
            background-color: var(--surface-container-low);
            height: 100vh;
            display: flex;
            flex-direction: column;
            padding-top: var(--margin-lg);
            padding-bottom: var(--margin-lg);
            border-right: 1px solid var(--outline-dark);
            position: fixed;
            left: 0;
            top: 0;
            z-index: 20;
        }


        /* ANA ALAN */

        .main-layout {
            width: calc(100% - var(--sidebar-width));
            min-height: 100vh;
            margin-left: var(--sidebar-width);
            background-color: var(--background);
            display: flex;
            flex-direction: column;
            position: relative;
        }


        /* TOP NAVBAR */

        .top-navbar {
            height: 64px;
            width: calc(100% - var(--sidebar-width));
            position: fixed;
            top: 0;
            right: 0;
            z-index: 10;
            background-color: var(--surface);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-left: var(--margin-lg);
            padding-right: var(--margin-lg);
            border-bottom: 1px solid var(--outline-dark);
        }


        /* ANA İÇERİK */

        .main-content {
            flex: 1;
            margin-top: 64px;
            padding: var(--margin-lg);
            overflow-y: auto;
            overflow-x: hidden;
            min-height: calc(100vh - 64px);
        }


        /* LOGO */

        .logo-container {
            padding: 0 var(--margin-lg);
            margin-bottom: 32px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--primary-container);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .logo-icon .material-symbols-outlined {
                color: var(--surface);
                font-weight: bold;
            }

        .logo-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--primary-container);
            margin: 0;
            line-height: 1.4;
        }

        .logo-subtitle {
            font-size: 12px;
            color: var(--on-surface-muted);
            margin: 0;
            line-height: 1.4;
        }


        /* YENİ İLETİ */

        .cta-container {
            padding: 0 var(--margin-lg);
            margin-bottom: 24px;
        }

        .btn-new-email {
            width: 100%;
            background-color: var(--primary-container);
            color: var(--surface);
            font-size: 12px;
            font-weight: 600;
            padding: 12px;
            border-radius: 8px;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            transition: background-color 0.2s;
        }

            .btn-new-email:hover {
                background-color: var(--surface-tint);
            }


        /* MENÜ */

        .nav-menu {
            flex: 1;
            overflow-y: auto;
            width: 100%;
        }

        .nav-link-item {
            display: flex;
            align-items: center;
            gap: var(--unit);
            color: var(--on-surface-muted);
            padding: 8px var(--gutter);
            transition: all 0.2s;
            font-size: 12px;
            font-weight: 600;
        }

            .nav-link-item:hover {
                background-color: var(--surface-container-highest);
                color: var(--on-surface);
            }

        .nav-link-active {
            border-left: 2px solid var(--primary-container);
            background-color: var(--surface-container-high);
            color: var(--primary-container);
            padding: 8px var(--gutter);
            font-weight: 700;
        }

            .nav-link-active .material-symbols-outlined {
                font-variation-settings: 'FILL' 1;
            }


        /* KULLANICI PROFİLİ */

        .user-profile {
            padding: 16px var(--margin-lg) 0;
            margin-top: auto;
            border-top: 1px solid var(--outline-dark);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid var(--outline-dark);
        }

        .user-name {
            font-size: 12px;
            font-weight: 600;
            color: var(--on-surface);
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-email {
            font-size: 12px;
            color: var(--on-surface-muted);
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }


        /* ARAMA */

        .search-container {
            position: relative;
            width: 100%;
            max-width: 28rem;
        }

        .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--on-surface-muted);
        }

        .search-input {
            width: 100%;
            background-color: var(--surface-container-low);
            border: 1px solid var(--outline-dark);
            color: var(--on-surface);
            border-radius: 8px;
            padding: 8px 16px 8px 40px;
            font-size: 14px;
            outline: none;
            transition: all 0.2s;
        }

            .search-input:focus {
                border-color: var(--primary-container);
                box-shadow: 0 0 0 1px rgba(249, 115, 22, 0.2);
            }

        .subject-input{
            width: 100%;
            background-color: var(--surface-container-low);
            border: 1px solid var(--outline-dark);
            color: var(--on-surface);
            border-radius: 8px;
            padding: 8px 16px 8px 14px;
            font-size: 14px;
            outline: none;
            transition: all 0.2s;
        }

        /* NAVBAR BUTONLARI */

        .nav-btn {
            background: none;
            border: none;
            color: var(--on-surface-muted);
            padding: 8px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
            cursor: pointer;
        }

            .nav-btn:hover {
                background-color: var(--surface-container-high);
            }


        /* SCROLLBAR */

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background-color: #333333;
            border-radius: 10px;
        }

            .custom-scrollbar::-webkit-scrollbar-thumb:hover {
                background-color: #474747;
            }


        /* MOBİL */

        @@media (max-width: 768px) {
            .sidebar

        {
            display: none;
        }

        .main-layout {
            width: 100%;
            margin-left: 0;
        }

        .top-navbar {
            width: 100%;
            padding-left: 16px;
            padding-right: 16px;
        }

        .main-content {
            padding: 16px;
        }

        }
    </style>
</head>

<body>
    
 @if (SignInManager.IsSignedIn(User))
        {
         

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <!-- LOGO -->
        <div class="logo-container">

            <div class="logo-icon">
                <span class="material-symbols-outlined">
                    rocket_launch
                </span>
            </div>

            <div>
                <h1 class="logo-title">
                    Obsidian Mail
                </h1>

                <p class="logo-subtitle">
                    Pro Command Center
                </p>
            </div>

        </div>


        <!-- YENİ İLETİ -->
        <div class="cta-container">

            <a class="btn-new-email" href="/Message/SendMail">

                <span class="material-symbols-outlined"
                      style="font-variation-settings: 'FILL' 1;">
                    edit_square
                </span>

                Yeni İleti

            </a>

        </div>


        <!-- MENÜ -->
        <nav class="nav-menu custom-scrollbar">

            <ul>

                <li>
                    <a class="nav-link-item" href="/Profile/Index">
                        <span class="material-symbols-outlined">
                            dashboard
                        </span>

                        <span>
                            Profil
                        </span>
                    </a>
                </li>

                <li>
                    <a class="nav-link-item nav-link-active" href="/Message/Index">
                        <span class="material-symbols-outlined">
                            inbox
                        </span>

                        <span>
                            Gelen Kutusu (Okunmamış @ViewBag.NotIsReadMessages )
                        </span>
                    </a>
                </li>

                <li>
                    <a class="nav-link-item" href="/Message/SentMessages">
                        <span class="material-symbols-outlined">
                            drafts
                        </span>

                        <span>
                            Gönderilenler
                        </span>
                    </a>
                </li>

                <li>
                    <a class="nav-link-item" href="/Draft/Index">
                        <span class="material-symbols-outlined">
                            star
                        </span>

                        <span>
                            Taslaklar
                        </span>
                    </a>
                </li>


                <li>
                    <a class="nav-link-item" href="/Message/ImportantMessages">
                        <span class="material-symbols-outlined">
                            star
                        </span>

                        <span>
                            Önemli Mesajlar
                        </span>
                    </a>
                </li>

                <li>
                    <a class="nav-link-item" href="/Message/Trash">
                        <span class="material-symbols-outlined">
                            star
                        </span>

                        <span>
                            Çöp Kutusu
                        </span>
                    </a>
                </li>
                <li>
                    <a class="nav-link-item" href="/Category/Index">
                        <span class="material-symbols-outlined">
                            star
                        </span>

                        <span>
                            Kategoriler
                        </span>
                    </a>
                </li>
             
               
            </ul>

        </nav>
   
        
      
        <div class="user-profile">

            <img alt="User profile avatar"
                 class="avatar"
                 src="https://lh3.googleusercontent.com/aida-public/AB6AXuAa148Dk2bIquH-8M_csXxZ5RsSzRU8PDiW83zlM7NepZG4OeUd1UiD8dJZQ6XeZul__Uh0HhnTvbW2Ej1KlE0wILMbut8PdLvnNqQMM94Vl6l5esGQacNHhl0lY0Rv2PzyOc0RyJq6TP6f4PPChO4Vf6x2AeuPmJlUkBfuaBZMzXEExcQN5gPlk5ri5mW3p33t5DAy5RxIR1cKnv4lnrTE9TItjR366_iJ3ZPmIgY2ku-NgSQ45Aylpg" />

            <div style="overflow: hidden;">

                <p class="user-name">
                        @{
                            var currentuser = await UserManager.GetUserAsync(User);
                        }
                        @currentuser.FirstName @currentuser.LastName
                </p>

                <p class="user-email">
                    @currentuser.Email
                </p>

            </div>

        </div>

    </aside>


    <!-- ANA LAYOUT -->
    <div class="main-layout">

        <!-- NAVBAR -->
        <header class="top-navbar">

            <div class="d-flex align-items-center gap-3 flex-grow-1">

                <div class="d-md-none d-flex align-items-center gap-2">

                    <span class="material-symbols-outlined text-primary">
                        rocket_launch
                    </span>

                    <span class="fs-5 fw-bold">
                        Obsidian
                    </span>

                </div>

            </div>


            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                    <a href="/Auth/Logout">
                        <span class="material-symbols-outlined">
                            logout
                        </span>
                    </a>
                   
                <div class="ms-2 ps-3 border-start border-secondary d-md-none">

                    <img alt="User Profile"
                         src="https://lh3.googleusercontent.com/aida-public/AB6AXuC_xbnMFknUDW3vHmVsXTV7015G7aW_VoVoLUzaMbwsH2CmKXylbuqDHTmu09-_uJ3Q9tdjpUAhiIEKpZFGRGhsb2aQoOLI8LkxmUJntrpP6LZJaec3xmbKqiAVV7WaYmUbK4nE6ZE6EnSSxKj-Mg4eU4FM9QlTnPtrqdu7EebD8dOPqeesaTY1S-2ADit2RFFnGjkfhn85JRyGJwL3wKFjS0QHcKJ6M25VM-uLHd3kNgcyQl3Zm4viCQ"
                         style="width:32px;height:32px;border-radius:50%;object-fit:cover;" />

                </div>

            </div>

        </header>


        <!-- BURASI INDEX GİBİ SAYFALARI GETİRECEK -->
        @RenderBody()

    </div>


    <!-- BOOTSTRAP JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    @RenderSection("Scripts", required: false)

    <script>
        $('.email-body').on('click', function(){
            var $mailrow = $(this).closest('.email-item');
            var $div= $mailrow.find('#mailid');
           
            $id= $div.data("id");

           window.location.href = '/Message/MailDetail/' + $id;

            
            
        })
    </script>
    }
</body>
</html>