@model List<UserMessage>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<main class="main-content">

   
    <!-- Header / Filters -->
    <div class="page-header">

        <div>
            <h2 class="page-title">
                Taslaklar
            </h2>
        </div>


        <div class="search-container d-none d-md-block">

            <span class="material-symbols-outlined search-icon">
                search
            </span>

            <input class="search-input"
                  
                   type="text" />

        </div>


        <div class="d-flex gap-2">

            <button class="filter-btn">

                <span class="material-symbols-outlined"
                      style="font-size: 18px;">
                    filter_list
                </span>

                Filtrele

            </button>


            <button class="filter-btn">

                <span class="material-symbols-outlined"
                      style="font-size: 18px;">
                    sort
                </span>

                Sırala

            </button>

        </div>

    </div>


    <!-- Email List -->
    <div class="email-list custom-scrollbar">

        @foreach (var item in Model)
        {
            <div class="email-item">

                <!-- Email Header -->
                <div class="email-header">

                    <!-- Receiver -->
                    <div class="email-sender">

                        <span class="sender-name">
                            @(item.Receiver != null
                                                    ? $"{item.Receiver.FirstName} {item.Receiver.LastName}"
                                                    : "Alıcı belirtilmemiş")
                    </span>

                    </div>


                    <!-- Right Side -->
                    <div class="email-actions">

                        <span class="email-time">
                            @item.SendDate.ToString("dd.MM.yyyy HH:mm")
                        </span>


                        <!-- Düzenle -->
                        <a href="/Draft/Edit/@item.Id"
                           class="btn btn-warning draft-edit-btn">
                            Düzenle
                        </a>


                        <!-- Tamamen Sil -->
                        <a href="/Draft/Delete/@item.Id"
                           class="btn btn-danger draft-delete-btn">
                            Tamamen Sil
                        </a>

                    </div>

                </div>


                <!-- Email Body -->
                <div class="email-body">

                    <h3 class="email-subject">
                        @item.Subject
                    </h3>

                    <p class="email-preview">
                        @item.Body
                    </p>

                </div>

            </div>
                }

    </div>
   

</main>

<style>

  

    .email-list {
        min-height: 450px;
        margin-top: 20px;
    }


   

    .email-item {
        background-color: #292929;
        border: 1px solid #3a3a3a;
        border-radius: 10px;
        margin-bottom: 10px;
        overflow: hidden;
        transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }


        .email-item:hover {
            background-color: #2d2d2d;
            border-color: #4a4a4a;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        }


        .email-item:last-child {
            margin-bottom: 0;
        }


    /* ================================
           MAIL HEADER
           ================================ */

    .email-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 16px;
        border-bottom: 1px solid #3a3a3a;
    }


    /* Alıcı */
    .email-sender {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }


    /* Alıcı adı */
    .sender-name {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    /* ================================
           MAIL BODY
           ================================ */

    .email-body {
        padding: 14px 16px;
    }


    .email-subject {
        margin: 0 0 6px 0;
    }


    .email-preview {
        margin: 0;
    }


    /* ================================
           MAIL ACTIONS
           ================================ */

    .email-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }


    /* Tarih */
    .email-time {
        display: block;
        min-width: 125px;
        text-align: right;
        white-space: nowrap;
        font-size: 12px;
    }


    /* ================================
           TASLAK BUTONLARI
           ================================ */

    .draft-edit-btn,
    .draft-delete-btn {
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        transition: all 0.2s ease;
    }


    /* Düzenle */
    .draft-edit-btn {
        background-color: #3a3a3a;
        border: 1px solid #4a4a4a;
        color: #ffb599;
    }


        .draft-edit-btn:hover {
            background-color: #474747;
            border-color: #ffb599;
            color: #ffb599;
        }


    /* Tamamen Sil */
    .draft-delete-btn {
        background-color: transparent;
        border: 1px solid #5a3a35;
        color: #ffb4ab;
    }


        .draft-delete-btn:hover {
            background-color: rgba(255, 180, 171, 0.1);
            border-color: #ffb4ab;
            color: #ffb4ab;
        }


    /* ================================
           MOBİL
           ================================ */

    @@media (max-width: 768px) {

        .email-item {
            margin-bottom: 8px;
            border-radius: 8px;
        }


        .email-header {
            padding: 12px;
            gap: 8px;
        }


        .email-body {
            padding: 12px;
        }


        .email-actions {
            gap: 4px;
        }


        .email-time {
            min-width: auto;
            font-size: 11px;
        }


        .draft-edit-btn,
        .draft-delete-btn {
            height: 32px;
            padding-left: 8px;
            padding-right: 8px;
            font-size: 11px;
        }
    }

</style>
