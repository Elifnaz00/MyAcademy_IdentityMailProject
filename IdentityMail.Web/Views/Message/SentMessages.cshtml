@model List<UserMessage>

@{
    ViewData["Title"] = "SentMessages";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<main class="main-content">


    <!-- Header / Filters -->
    <div class="page-header">

        <div>
            <h2 class="page-title">
                Gönderilenler
            </h2>
        </div>

        <div class="search-container d-none d-md-block">

            <span class="material-symbols-outlined search-icon">
                search
            </span>

            <input class="search-input"
                  
                   type="text" />

        </div>

        <div class="d-flex gap-2">

            <button class="filter-btn">
                <span class="material-symbols-outlined" style="font-size: 18px;">
                    filter_list
                </span>
                Filtrele
            </button>

            <button class="filter-btn">
                <span class="material-symbols-outlined" style="font-size: 18px;">
                    sort
                </span>
                Sırala
            </button>

        </div>

    </div>


    <!-- Email List -->
    <div class="email-list custom-scrollbar">

        @foreach (var item in Model)
        {
            <div class="email-item">

                <div class="unread-indicator-bar"></div>

                <!-- Email Header -->
                <div class="email-header">

                    <!-- Sender -->
                    <div class="email-sender">

                        <div class="unread-dot"></div>

                        <span class="sender-name">
                            @item.Receiver.FirstName @item.Receiver.LastName
                        </span>

                    </div>


                    <!-- Right Side -->
                    <div class="email-actions">

                        <span class="email-time">
                            @item.SendDate.ToString("dd.MM.yyyy HH:mm")
                        </span>

                        <a href="/Message/MoveToTrash/@item.Id"
                           class="nav-btn delete-btn">

                            <span class="material-symbols-outlined">
                                delete
                            </span>

                        </a>

                    </div>

                </div>


                <!-- Email Body -->
                <div class="email-body">

                    <h3 class="email-subject">
                        @item.Subject
                    </h3>

                    <p class="email-preview">
                        @item.Body
                    </p>

                </div>

            </div>
        }

    </div>
    

</main>

<style>

    /* ================================
           MAIL LIST
           ================================ */

    .email-list {
        min-height: 450px;
        margin-top: 20px;
    }


    /* Her mail ayrı kart */
    .email-item {
        background-color: #292929;
        border: 1px solid #3a3a3a;
        border-radius: 10px;
        margin-bottom: 10px;
        overflow: hidden;
        transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }


        /* Mail üzerine gelindiğinde */
        .email-item:hover {
            background-color: #2d2d2d;
            border-color: #4a4a4a;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        }


        /* Son mail */
        .email-item:last-child {
            margin-bottom: 0;
        }


    /* ================================
           MAIL HEADER
           ================================ */

    .email-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 16px;
        border-bottom: 1px solid #3a3a3a;
    }


    /* Gönderen */
    .email-sender {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }


    /* Gönderen adı */
    .sender-name {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    /* ================================
           MAIL BODY
           ================================ */

    .email-body {
        padding: 14px 16px;
    }


    /* Konu */
    .email-subject {
        margin: 0 0 6px 0;
    }


    /* Mesaj önizleme */
    .email-preview {
        margin: 0;
    }


    /* ================================
           MAIL ACTIONS
           ================================ */

    .email-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }


    /* Tarih */
    .email-time {
        display: block;
        min-width: 125px;
        text-align: right;
        white-space: nowrap;
        font-size: 12px;
    }


    /* Sil butonu */
    .delete-btn {
        flex-shrink: 0;
        transition: all 0.2s ease;
    }


        .delete-btn:hover {
            color: var(--error) !important;
            background-color: rgba(255, 180, 171, 0.1) !important;
        }


    /* ================================
           MOBİL
           ================================ */

    @@media (max-width: 768px) {

        .email-item {
            margin-bottom: 8px;
            border-radius: 8px;
        }

        .email-header {
            padding: 12px;
            gap: 8px;
        }

        .email-body {
            padding: 12px;
        }

        .email-actions {
            gap: 4px;
        }

        .email-time {
            min-width: auto;
            font-size: 11px;
        }
    }

</style>
