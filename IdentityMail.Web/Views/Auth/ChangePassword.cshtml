@model ChangePasswordDto
@{
    ViewData["Title"] = "ChangePassword";
    Layout = "~/Views/Shared/_UserLoginLayout.cshtml";
}

<main class="main-content">
    <div class="auth-form-card">
        <div class="profile-form-header">
            <h2>Şifre Değiştir</h2>
			<p>Mevcut şifrenizi ve yeni şifrenizi girerek şifrenizi değiştirebilirsiniz.</p>
        </div>


        <form method="post" asp-controller="Auth" asp-action="ChangePassword">
            <div class="row">
                <div class="col-md-12 mb-3">
                    <label class="form-label">
                        Mevcut Şifre
                    </label>
                    <input type="password"
                           class="form-control"
                           asp-for="CurrentPassword"
                          
						    />
                </div>
                <div class="col-md-12 mb-3">
                    <label class="form-label">
                        Yeni Şifre
                    </label>
                    <input type="password"
                        asp-for="NewPassword"
                           class="form-control"
						    />
                </div>
                <div class="col-md-12 mb-3">
                    <label class="form-label">
                        Yeni Şifreyi Onayla
                    </label>
                    <input type="password"
                        asp-for="ConfirmNewPassword"
						   class="form-control" />
                </div>  
            </div>
            <div class="text-danger" asp-validation-summary="All"></div>
            <div class="text-end">

                <button type="submit"
                        class="btn theme-button">

                    <span class="material-symbols-outlined">
                        save
                    </span>

                    Değişiklikleri Kaydet

                </button>

            </div>
        </form>
    </div>
</main>

