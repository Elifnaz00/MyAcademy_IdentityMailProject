@model Category
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<main class="flex-1 mt-16 p-margin-lg overflow-y-auto w-full">
    <div class="max-w-5xl mx-auto">
        <!-- Page Header -->
        <div class="mb-8">
            <h2 class="font-display-lg text-display-lg text-on-surface font-bold tracking-tight mb-2">Kategori Yönetimi</h2>
            <p class="font-body-lg text-body-lg text-on-surface-muted">E-postalarınızı düzenlemek için etiket ve kategorileri yönetin.</p>
        </div>
        <!-- Bento Grid Layout for Content -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Left Column: Add Category Form (Takes up 4 cols on large screens) -->
            <div class="lg:col-span-4">
                <div class="bg-surface-container-low border border-outline-dark rounded-xl p-6 shadow-sm sticky top-24">
                    <h3 class="font-headline-sm text-headline-sm text-on-surface mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary-container">add_circle</span>
                        Yeni Kategori
                    </h3>
                    <form action="Create" controller="Category" class="space-y-4" method="POST">
                        <div>
                            <label class="block font-label-md text-label-md text-on-surface-muted mb-2" for="category_name">Kategori Adı</label>
                            <input class="w-full bg-background border border-outline-dark rounded-lg py-2.5 px-4 text-on-surface font-body-md focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container/20 transition-all" id="category_name" asp-for="Name" required="" type="text" />
                        </div>
                       
                        <div class="pt-2">
                            <button class="w-full bg-primary-container text-background font-label-md text-label-md py-2.5 rounded-lg hover:brightness-110 transition-all font-bold" type="submit">
                                Kategori Ekle
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            <!-- Right Column: Category List (Takes up 8 cols on large screens) -->
            @await Component.InvokeAsync("CategoryList")
            
        </div>
    </div>
</main>

