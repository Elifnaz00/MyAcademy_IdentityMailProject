
@{
    ViewData["Title"] = "ForgotPassword";
    Layout = "~/Views/Shared/_UserLoginLayout.cshtml";
}


<main class="main-content">
    <div class="auth-form-card">
        <div class="profile-form-header">
            <h2>Şifremi Unuttum!</h2>
            <p>Şifre Yenileme Bağlantısı için Eposta Adresinizi Giriniz. </p>
        </div>


        <form method="post">
            <div class="row">
                <div class="col-md-12 mb-3">
                    <label class="form-label">
                        E-posta Adresi
                    </label>
                    <input type="email"
                           class="form-control"
                           name="CurrentPassword theme-input"
                           required />
                </div>
               
            </div>
            <div class="text-end">

                <button type="submit"
                        class="btn theme-button">

                    Bağlantı Gönder

                </button>

            </div>
        </form>
    </div>
</main>

